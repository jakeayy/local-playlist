{
  "name": "Local Playlist",
  "short_name": "Local Playlist",
  "description": "Private, offline-friendly music player for YouTube, YouTube Music and SoundCloud links.",
  "start_url": "./",
  "display": "browser",
  "background_color": "#FEF7FF",
  "theme_color": "#6750A4",
  "icons": [
    { "src": "img/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "img/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "img/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
